# Public site origin used for canonical URLs, sitemap, Open Graph, and JSON-LD.
# Example production value:
NEXT_PUBLIC_SITE_URL=https://www.stg-qatar.com

# Optional contact delivery (server-only — never expose to the client).
# Prefer one of these when wiring email later:
# CONTACT_WEBHOOK_URL=https://hooks.example.com/stg-contact
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=info@stg-qatar.com
